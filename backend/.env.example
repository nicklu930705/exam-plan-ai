# ───── OpenAI 設定 (預設首選) ─────
# OpenAI API 金鑰 (由 OpenAI Platform 取得: https://platform.openai.com/)
OPENAI_API_KEY=your_openai_api_key_here

# 使用之 OpenAI 模型名稱 (預設推薦 gpt-5.6-luna，亦可填 gpt-4o-mini 等)
OPENAI_MODEL=gpt-5.6-luna

# ───── Google Gemini 設定 (備援方案) ─────
# Google Gemini API 金鑰 (由 Google AI Studio 取得: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# ───── 提供商強制指定 (選填: 'openai' 或 'gemini') ─────
AI_PROVIDER=openai
