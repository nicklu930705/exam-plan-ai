# ───── OpenAI 設定 (預設首選) ─────
# OpenAI API 金鑰 (由 OpenAI Platform 取得: https://platform.openai.com/)
OPENAI_API_KEY=your_openai_api_key_here

# 使用之 OpenAI 模型名稱 (預設推薦 gpt-5.6-luna，亦可填 gpt-4o-mini 等)
OPENAI_MODEL=gpt-5.6-luna

# ───── Google Gemini 設定 (備援方案) ─────
# Google Gemini API 金鑰 (由 Google AI Studio 取得: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# ───── 提供商強制指定 (選填: 'openai' 或 'gemini') ─────
AI_PROVIDER=openai

# ───── Upstash Redis 設定 (分散式限流、配額與預算原子控制) ─────
# 可在 Upstash 控制台 (https://console.upstash.com/) 或 Vercel Marketplace 建立
UPSTASH_REDIS_REST_URL=https://your-database-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# ───── 配額與速率限制設定 (未填則採用安全預設值) ─────
FREE_DAILY_AI_LIMIT=3
PRO_DAILY_AI_LIMIT=15
AI_RATE_LIMIT_PER_MINUTE=3
AI_MAX_INPUT_CHARS=4000
AI_MAX_OUTPUT_TOKENS=600
AI_REQUEST_TIMEOUT_MS=20000
AI_MAX_RETRIES=1

# ───── 伺服端預算控制 (美元 USD) ─────
AI_DAILY_BUDGET_USD=0.5
AI_MONTHLY_BUDGET_USD=5.0
AI_BUDGET_WARNING_PERCENT=50
